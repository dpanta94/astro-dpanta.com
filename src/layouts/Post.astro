---
import Base from "./Base.astro";

interface Props {
  title: string;
  date: Date;
  description?: string;
  image?: string;
  tags?: string[];
}

const { title, date, description, image, tags = [] } = Astro.props;

const dateISO = date.toISOString().split("T")[0];
const dateDisplay = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={title} description={description} image={image} isArticle={true} date={date} tags={tags}>
  <article>
    <h1>{title}</h1>
    <div class="post-meta">
      <time datetime={dateISO}>{dateDisplay}</time>
      {tags.length > 0 && (
        <span class="tag-list">
          {tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag">{tag}</a>
          ))}
        </span>
      )}
    </div>
    <slot />
  </article>
</Base>
